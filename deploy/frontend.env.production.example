# Copy to /srv/myproject/app/frontend/.env before `npm run build`.
# Vite bakes these into the built files at build time — so anything here is
# public, visible to anyone who opens the browser's dev tools. Never put a
# secret in a VITE_ variable; a Google *client* ID is public by design.
#
# Present and EMPTY: the API is on the same domain, so requests go to /api/
# with no host in front of them.
VITE_API_URL=
VITE_GOOGLE_CLIENT_ID=
