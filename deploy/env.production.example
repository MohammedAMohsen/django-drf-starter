# Copy to /srv/myproject/app/backend/.env on the server and fill the blanks.
# Generate the key with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(50))"
#
# chmod 600 this file and let only the service user read it: every secret
# the application has is in here.

SECRET_KEY=
DEBUG=False

ALLOWED_HOSTS=example.com,www.example.com
CSRF_TRUSTED_ORIGINS=https://example.com,https://www.example.com
# Same origin as the API — no cross-origin calls — so this stays empty.
CORS_ALLOWED_ORIGINS=

SITE_NAME=MyProject
# Host only, no scheme: the mailed links are built from it.
FRONTEND_URL=example.com
SERVE_SPA=True

# Not `admin/`. Any word, known only to you.
ADMIN_URL=

DB_NAME=myproject
DB_USER=myproject
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

REDIS_URL=redis://127.0.0.1:6379
CELERY_ALWAYS_EAGER=False

# Outside the repository, so a fresh clone or a reset never touches uploads.
MEDIA_ROOT=/srv/myproject/media

# Mail through a relay (Resend, Postmark, SES) from your own domain, with
# SPF/DKIM/DMARC set on it at the DNS provider — without those records the
# mail goes to spam, or nowhere. With Resend, EMAIL_USER is literally the
# word "resend" and EMAIL_PASS is a sending-only API key.
EMAIL_HOST=smtp.resend.com
EMAIL_PORT=587
EMAIL_USER=resend
EMAIL_PASS=
DEFAULT_FROM_EMAIL=MyProject <hello@example.com>

GOOGLE_CLIENT_ID=

AXES_ENABLED=True

SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.1

LOG_LEVEL=INFO
