# Copy to .env and fill in. .env is never committed (see .gitignore).
# Generate a key with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(50))"

# --- Django ---------------------------------------------------------------
SECRET_KEY=change-me-generate-a-new-one
DEBUG=True
# Required once DEBUG=False, or the process refuses to start.
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Shown in emails and in the API docs.
SITE_NAME=MyProject
# Where the front end lives — host only, no scheme. Mail links are built
# from it, so a wrong value produces links that go nowhere.
FRONTEND_URL=localhost:5173
# Serve the built front end from Django (see config/spa.py).
SERVE_SPA=False

# Move the admin off the path every scanner tries first.
ADMIN_URL=admin/

# --- PostgreSQL -----------------------------------------------------------
DB_NAME=myproject_db
DB_USER=myproject
DB_PASSWORD=change-me
DB_HOST=localhost
DB_PORT=5432

# --- Redis (cache + Celery) ----------------------------------------------
REDIS_URL=redis://127.0.0.1:6379
# Development only: run background tasks inline, no worker needed.
CELERY_ALWAYS_EAGER=False

# --- Mail -----------------------------------------------------------------
# Left empty in development, mail is printed to the console instead of sent.
# For Gmail this must be an app password, never the account password.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=
DEFAULT_FROM_EMAIL=

# --- Google sign-in -------------------------------------------------------
# Empty is fine; /api/v1/google/ then refuses every token.
GOOGLE_CLIENT_ID=

# --- Account lockout ------------------------------------------------------
# Locks an account (not an IP) after 5 failed sign-ins, for 1 hour.
# Off in development so a forgotten password does not lock you out of your
# own machine. Turn it on in production.
AXES_ENABLED=False

# --- Error reporting ------------------------------------------------------
# Empty = off, and nothing is even imported. Get a DSN from sentry.io and set
# it on the server; leaving it empty in development is the right default.
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=0.1

# --- Logging --------------------------------------------------------------
LOG_LEVEL=INFO

# --- Paths (both have working defaults; set only to override) -------------
# Where uploads are stored. Unset = backend/media/. On a server, point this
# outside the code directory — see SCALING.md.
# MEDIA_ROOT=/srv/myproject/media
# The built front end's index.html. Unset = ../frontend/dist/index.html.
# SPA_INDEX=
